# Local emulator only. Run adb reverse tcp:4138 tcp:4138 first.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:4138
EXPO_PUBLIC_AUTH_ORIGIN=http://127.0.0.1:4138

# Optional canonical web invitation origin; defaults to EXPO_PUBLIC_AUTH_ORIGIN.
# Match the backend NEXT_PUBLIC_APP_URL origin so shared links also work in browsers.
# EXPO_PUBLIC_INVITE_ORIGIN=http://127.0.0.1:4138
#
# Android native link settings require rebuilding the binary after changing this.
# HTTP links are development-only and are not verified Android App Links.
# A future staging binary must explicitly use EXPO_PUBLIC_APP_ENV=staging and an
# operator-owned HTTPS invitation origin. Other nondevelopment modes register no
# invitation filter. Staging authentication requires the settings below.
# Before claiming verified staging App Links, publish on that invitation host:
# https://<actual-staging-host>/.well-known/assetlinks.json
# It must be public HTTPS JSON, without redirects, containing relation
# delegate_permission/common.handle_all_urls and target namespace android_app,
# package_name matching the built APK (com.splitbook.app.staging for staging),
# and sha256_cert_fingerprints containing the actual APK signing certificate(s).
# The web app can serve this metadata after ANDROID_APP_LINKS_ENV=staging and
# ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS are configured on that staging host;
# see apps/web/.env.example. Those are server settings, not EXPO_PUBLIC values.
# No real staging host, signing fingerprint, or verified association is supplied here.

# Invited beta: use a separate staging server/database, never the production ledger.
# Replace these illustrative values with the verified deployment and public OAuth audience.
# EXPO_PUBLIC_APP_ENV=staging
# EXPO_PUBLIC_API_URL=https://your-staging-host.example
# EXPO_PUBLIC_AUTH_ORIGIN=https://your-staging-host.example
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<staging-web-client-id>.apps.googleusercontent.com
# The API and auth origins must be identical HTTPS origins. No secret belongs here.
# The backend must advertise the matching audience at /.well-known/splitbook-mobile.json.
# Signed builds cannot enable demo personas. Rebuild after changing build settings.
