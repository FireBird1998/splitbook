exports[`records dispatch authorization, invalid requests and a failed pass at HTTP 1`] = `
[
  {
    "answer": {
      "body": "{"error":"Unauthorized","status":401,"code":"UNAUTHORIZED"}",
      "hasCode": true,
      "status": 401,
    },
    "state": "no authorization",
  },
  {
    "answer": {
      "body": "{"error":"Invalid request","status":400,"code":"VALIDATION_ERROR"}",
      "hasCode": true,
      "status": 400,
    },
    "state": "unexpected query",
  },
  {
    "answer": {
      "body": "{"error":"Notification dispatch unavailable","status":503}",
      "hasCode": false,
      "status": 503,
    },
    "state": "dispatch failed",
  },
]
`;

