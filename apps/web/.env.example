MONGODB_URI=
# Secret for Better Auth session and cookie signing (openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails invited to this private beta. Google sign-in
# fails closed when this is missing or empty; it is re-checked on every sign-in.
AUTH_ALLOWED_EMAILS=
# Base URL of the app; Better Auth derives its base URL and trusted origin from it
NEXT_PUBLIC_APP_URL=http://localhost:4127

# Optional Android App Links metadata, staging only. Disabled by default.
# Set ANDROID_APP_LINKS_ENV=staging only on the real HTTPS invitation host, then
# provide the actual staging APK signing certificate SHA-256 fingerprint(s),
# comma-separated; each must contain 32 colon-separated hex bytes (AA:BB:...).
# /.well-known/assetlinks.json returns empty 404 JSON unless both values are valid.
# The associated package is fixed to com.splitbook.app.staging. These public
# fingerprints are not secrets; do not paste private keys or keystore contents.
# Native EXPO_PUBLIC_INVITE_ORIGIN and this host's NEXT_PUBLIC_APP_URL must match.
# Verify HTTPS JSON delivery without redirects and Android device association
# after deployment. This configuration alone does not verify App Links (#60).
ANDROID_APP_LINKS_ENV=
ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=

# Product switch for recurring Expenses (Household templates that add an Expense each
# month on their own). Off unless set to exactly `true`. Off hides the recurring section in
# Group settings, makes the recurring API refuse changes (409 RECURRING_EXPENSES_OFF) and
# list no templates, and stops every read and leave from adding a recurring Expense. Nothing
# stored is deleted. Turned back on, templates resume from that month: the months it was off
# are not back-filled. Server-only; on Vercel, set it for the environment and redeploy.
RECURRING_EXPENSES_ENABLED=

# Auth mode: google (default) | demo
AUTH_MODE=
# Required to use demo auth when NODE_ENV=production (fail closed otherwise)
ALLOW_DEMO_AUTH=

# Optional. Base MongoDB connection for integration tests — each test file
# derives its own `splitbook-test-<file>` database from it. The demo database
# is never used. Defaults to mongodb://127.0.0.1:27017/?directConnection=true
TEST_MONGODB_URI=

# Test-only. Never set on a real deployment.
# Enables locally signed Google ID tokens for the Google-mode browser suite
# (see src/lib/auth/test-id-token.ts). Ignored under NODE_ENV=production
# unless ALLOW_TEST_ID_TOKEN=true is also set.
AUTH_TEST_ID_TOKEN_SECRET=
ALLOW_TEST_ID_TOKEN=
# Overrides Better Auth's default (rate limiting on in production only).
# The browser suites set it to false for production builds on loopback.
AUTH_RATE_LIMIT_ENABLED=

# Only on the separate Android beta staging deployment, alongside AUTH_MODE=google:
# MOBILE_APP_ENV=staging
# Publishes public environment/audience metadata at /.well-known/splitbook-mobile.json.
# Leave unset on production. The route refuses demo/test-token environments.
