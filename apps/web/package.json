{
  "name": "@splitbook/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4127",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"src/**/*.integration.test.ts\"",
    "test:integration": "vitest run integration",
    "test:e2e": "playwright test",
    "test:expense-access": "playwright test --config playwright.expense-access.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:google": "playwright test --config playwright.google.config.ts",
    "test:design-system": "playwright test --config playwright.design-system.config.ts",
    "test:pilot": "playwright test --config playwright.pilot.config.ts",
    "test:production-ui": "playwright test --config playwright.production-ui.config.ts",
    "check:design-system": "tsx --tsconfig scripts/tsconfig.json scripts/check-design-system.ts",
    "typecheck": "tsc --noEmit",
    "demo:seed": "tsx --tsconfig scripts/tsconfig.json scripts/demo-seed.ts",
    "demo:reset": "tsx --tsconfig scripts/tsconfig.json scripts/demo-reset.ts",
    "migrate:auth": "tsx --tsconfig scripts/tsconfig.json scripts/migrate-auth.ts",
    "migrate:ledger": "tsx --tsconfig scripts/tsconfig.json scripts/migrate-ledger.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "@splitbook/shared": "workspace:*",
    "better-auth": "1.7.3",
    "date-fns": "^4.1.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "swr": "^2.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
