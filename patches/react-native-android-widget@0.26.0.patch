+                }
+            }
+            @Override public void onLowMemory() { }
+        };
+        context.getApplicationContext().registerComponentCallbacks(fontChanges);
+    }
+
+    @Override public void invalidate() {
+        getReactApplicationContext().getApplicationContext().unregisterComponentCallbacks(fontChanges);
+        super.invalidate();
